# @gleanwork/api-client SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: GLEAN_
#
# Security environment variables:
GLEAN_API_TOKEN=your_apitoken_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
GLEAN_DEBUG=true
